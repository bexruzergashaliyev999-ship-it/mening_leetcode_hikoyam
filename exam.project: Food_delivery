class Order:
    def __init__(self):
        self.items = {}

    def add_item(self, name, price, quantity):
        if quantity <= 0:
            print("more than 0")
            return

        if name in self.items:
            self.items[name]["quantity"] += quantity
        else:
            self.items[name] = {"price": price, "quantity": quantity}

    def total_price(self):
        return sum(item["price"] * item["quantity"] for item in self.items.values())

    def delivery_fee(self):
        total = self.total_price()
        if total == 0 or total > 100_000:
            return 0
        return 15_000

    def final_price(self):
        return self.total_price() + self.delivery_fee()

    def show_order(self):
        print("\n--- ORDER ---")

        if not self.items:
            print("Your order is empty.")
            return

        for name, info in self.items.items():
            item_total = info["price"] * info["quantity"]
            print(f"{name} x {info['quantity']} = {item_total:,} sum")

        print(f"\nTotal: {self.total_price():,} sum")

        if self.delivery_fee() == 0:
            print("Delivery: Free")
        else:
            print(f"Delivery: {self.delivery_fee():,} sum")

        print(f"Final price: {self.final_price():,} sum")


