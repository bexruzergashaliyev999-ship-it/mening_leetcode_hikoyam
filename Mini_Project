class MiniLoyha:
    def mini_loyha(self):
        n = int(input("Talabalar soni: "))
        talabalar = []

        for i in range(n):
            ism = input(f"{i+1}-talabaning ismi: ")
            familiya = input(f"{i+1}-talabaning familiyasi: ")
            ball = int(input(f"{i+1}-talabaning bali: "))

            talabalar.append([ism, familiya, ball])

      
        for i in range(n - 1):
            m = i
            for j in range(i + 1, n):
                if talabalar[j][2] > talabalar[m][2]:
                    m = j
            talabalar[i], talabalar[m] = talabalar[m], talabalar[i]

        print("\n----- Talabalar reytingi -----")
        for i, talaba in enumerate(talabalar, 1):
            print(f"{i}-orin: {talaba[0]} {talaba[1]} - {talaba[2]} ball")

        print("\n--- Eng katta ball topgan oquvchi ---")
        print(f"{talabalar[0][0]} {talabalar[0][1]} - {talabalar[0][2]} ball")

        print("\n--- Eng kichik ball topgan oquvchi ---")
        print(f"{talabalar[-1][0]} {talabalar[-1][1]} - {talabalar[-1][2]} ball")



project = MiniLoyha()
project.mini_loyha()
