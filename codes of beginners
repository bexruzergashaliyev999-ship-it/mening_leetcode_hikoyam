# --------------------- Login --------------------- #

login = input("Write the login: ")
code = int(input("Write the code: "))

if login == "admin" and code == 1234:
    print("Welcome")
else:
    print("Check your login or code!")

# --------------------- Age --------------------- #

age = int(input("Input your age: "))

if age >= 13:
    print("You can watch this film!")
else:
    print("You are not allowed.")

# --------------------- Discount --------------------- #

total = int(input("Write the amount: "))

if total >= 500000:
    discount = total * 0.9
    print("Price after discount:", discount)
else:
    print("Price:", total)

# --------------------- Battery --------------------- #

battery = int(input("Battery percentage: "))

if battery < 20:
    print("Please charge the phone.")
elif 20 <= battery <= 80:
    print("Battery life is good.")
else:
    print("Battery is nearly full.")

# --------------------- Student List --------------------- #

students = []

name = input("Enter a student's name: ")
students.append(name)

print("Students:", students)

# --------------------- Code --------------------- #

code = input("Input the code: ")

if len(code) < 8:
    print("Code is too short.")
else:
    print(f"{code} - Code accepted")

# --------------------- Market --------------------- #

quantity_of_products = int(input("How many products do you want to buy? "))

products = []

for i in range(quantity_of_products):
    product = input(f"Enter product {i + 1}: ")
    products.append(product)

print("Your products:", products)

# --------------------- Emoji Count --------------------- #

emoji = input("Emoji: ")
print("Number of characters:", len(emoji))

# --------------------- Find the Name --------------------- #

names = []

count = int(input("How many names do you want to enter? "))

for i in range(count):
    name = input(f"Enter name {i + 1}: ")
    names.append(name)

find = input("Enter the name you're looking for: ")

if find in names:
    print("Found!", find)
else:
    print("There is no such name in the list.")

# --------------------- Guest List --------------------- #

guest_count = int(input("Enter the number of guests: "))

guests = []

for i in range(guest_count):
    name = input(f"Enter guest {i + 1} name: ")
    guests.append(name)

print("\nTotal guests:", len(guests))
print("First guest:", guests[0])
print("Last guest:", guests[-1])
