#------------------guest list-------------------------- #


guest_count = int(input("Enter the number of guests: "))

guests = []

for i in range(guest_count):
    name = input(f"Enter guest {i + 1} name: ")
    guests.append(name)

print("\nTotal guests:", len(guests))
